# Agent Arena on NEAR. Copy to .env; never commit real values.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:5173
# NEP-413 sign-in "recipient"; must match what the browser sees.
PUBLIC_HOSTNAME=localhost
DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/arena

# --- NEAR ---------------------------------------------------------------
NEAR_NETWORK=testnet
# Optional; defaults to FastNEAR public RPC for the network.
NEAR_RPC_URL=
# Account the arena contract (contracts/near) is deployed to. Agents become <name>.<this account>.
ARENA_CONTRACT_ID=
# Operator account set in the contract's `new(operator, ...)`. Its key signs create_agent,
# create_tournament, start, cancel and finalize. Server only.
ARENA_OPERATOR_ID=
ARENA_OPERATOR_PRIVATE_KEY=
# 32 random bytes as hex (openssl rand -hex 32). Encrypts each agent's restricted function-call key.
AGENT_KEY_SECRET=

# --- NEAR AI Cloud (private TEE inference) ------------------------------
# Key from https://cloud.near.ai or the NEAR Builders $10 credit (https://nearbuilders.org/dashboard).
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai
# Comma-separated allowlist of TEE-hosted models agents may use.
NEARAI_MODELS=Qwen/Qwen3.6-35B-A3B-FP8,z-ai/glm-5.3-flash,Qwen/Qwen3.8-27B
AGENT_TIMEOUT_MS=15000
# Set to "fixture" to run tournaments with the deterministic test policy instead of a model (local demos without a key).
ARENA_DECISION_POLICY=

# --- NEAR Intents (1Click, mainnet-only; the arena requests dry quotes) -
# Mainnet NEAR account used as the quote recipient. Leave empty to disable quotes.
INTENTS_QUOTE_RECIPIENT=
# Optional JWT from https://partners.near-intents.org (removes the unauthenticated fee).
ONECLICK_JWT=

# --- Agent Market (market.near.ai) -------------------------------------
# aat_... token of the "Arena Coach" listing. Leave empty to disable the worker.
AGENT_MARKET_TOKEN=
AGENT_MARKET_LISTING_URL=
