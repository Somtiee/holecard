# Holecard on NEAR. Copy to .env; never commit real values.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:5173
# NEP-413 sign-in "recipient"; must match what the browser sees.
PUBLIC_HOSTNAME=localhost
DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/arena

# --- NEAR ---------------------------------------------------------------
NEAR_NETWORK=testnet
# Optional; defaults to FastNEAR public RPC for the network.
NEAR_RPC_URL=
# Account the arena contract (contracts/near) is deployed to. Agents become <name>.<this account>.
ARENA_CONTRACT_ID=
# Operator account set in the contract's `new(operator, ...)`. Its key signs create_agent,
# create_tournament, start, cancel and finalize. Server only.
ARENA_OPERATOR_ID=
ARENA_OPERATOR_PRIVATE_KEY=
# 32 random bytes as hex (openssl rand -hex 32). Encrypts each agent's restricted function-call key.
AGENT_KEY_SECRET=

# --- NEAR AI Cloud (private TEE inference) ------------------------------
# Key from https://cloud.near.ai or the NEAR Builders $10 credit (https://nearbuilders.org/dashboard).
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai
# Comma-separated allowlist of TEE-hosted models agents may use.
NEARAI_MODELS=Qwen/Qwen3.6-35B-A3B-FP8,z-ai/glm-5.3-flash
AGENT_TIMEOUT_MS=15000
# Set to "fixture" to run tournaments with the deterministic test policy instead of a model (local demos without a key).
ARENA_DECISION_POLICY=

# --- NEAR Intents (1Click, mainnet-only; the arena requests dry quotes) -
# Dry quotes execute nothing; the recipient only has to be a valid mainnet account and defaults to
# the Intents contract (intents.near). Set INTENTS_QUOTES=off to hide quotes.
INTENTS_QUOTES=
INTENTS_QUOTE_RECIPIENT=
# Optional JWT from https://partners.near-intents.org (removes the unauthenticated fee).
ONECLICK_JWT=

# --- Agent Market (market.near.ai) -------------------------------------
# aat_... token of the "Arena Coach" listing. Leave empty to disable the worker.
AGENT_MARKET_TOKEN=
AGENT_MARKET_LISTING_URL=

# --- Gasless play: NEP-366 relayer + NEAR Auth -------------------------
# Relayer account that pays gas for delegate actions and NEAR Auth `sign` calls (defaults to the operator).
RELAYER_ID=
RELAYER_PRIVATE_KEY=
# NEAR Auth (email/Google/passkey). Empty = NEAR Auth's shared testnet client, which only accepts the callback
# http://localhost:3000/. The server checks whether this PUBLIC_ORIGIN is allowed and offers the option only then.
# A dedicated client for your domain: set its client id, Auth0 domain and signing audience.
FASTAUTH_CLIENT_ID=
FASTAUTH_DOMAIN=
FASTAUTH_SIGNING_AUDIENCE=
# Arena-wide cap on NEAR Auth MPC signing relays per hour (they run before sign-in, paid by the relayer).
FASTAUTH_RELAY_HOURLY_CAP=120
FASTAUTH_CONTRACT_ID=fast-auth.testnet
FASTAUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
# One-time testnet starter stake (NEAR) deposited by the operator for each new owner. 0 disables.
SPONSOR_NEAR=1
# Arena-wide cap on starter stakes per 24 h (implicit-account sign-ins are free to create).
SPONSOR_DAILY_CAP=25
# Starter stakes pause before the operator balance drops below this many NEAR (default 3).
OPERATOR_RESERVE_NEAR=
# Arena-wide cap on new agent accounts per hour; the operator attaches the 0.1 NEAR seed for each one.
AGENT_CREATE_HOURLY_CAP=30

# --- House agents --------------------------------------------------------
# HOUSE GRANITE / VIPER / MIRAGE: real agents the operator funds so one player can start a table.
# They only join when a tournament creator clicks "fill empty seats". Set to "off" to disable.
HOUSE_AGENTS=on
# Largest entry fee (NEAR) the house will pay for one seat.
HOUSE_MAX_ENTRY_NEAR=1

# --- Hosting ------------------------------------------------------------
# Number of reverse-proxy hops in front of the server, so per-IP rate limits see real client IPs.
# Defaults to 1 on Railway and off elsewhere. Leave empty when the server is exposed directly.
TRUST_PROXY=
