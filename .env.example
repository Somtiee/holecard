# Agent Arena production profile. Copy to .env; never commit real values.
HOST=127.0.0.1
PORT=8787
# ERC-8004 registration requires the final HTTPS origin for public metadata.
PUBLIC_ORIGIN=http://127.0.0.1:5173
PUBLIC_HOSTNAME=localhost
DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/arena

# Arc Testnet (chain ID 5042002). Circle operator wallet must match the
# deployed ArenaFactoryV2.operator() address and hold testnet USDC for gas.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARENA_FACTORY_ADDRESS=
ARENA_OPERATOR_ADDRESS=
ARENA_OPERATOR_WALLET_ID=

# Circle Developer-Controlled Wallets. Server only; never prefix with VITE_.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# OpenAI-compatible model gateway. List only models you have configured.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ALLOWED_MODELS=
AGENT_TIMEOUT_MS=4000

# Separate one-time contract deployment script only; never set on Railway.
ARENA_DEPLOYER_PRIVATE_KEY=

# Circle App Kit funding uses the creator browser wallet on supported testnets.
# No browser API key or private key is needed. Registry and Multicall3From
# addresses are pinned to official Arc Testnet deployments in src/shared/arc.ts.
