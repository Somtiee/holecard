{
  "name": "agent-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/production/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/production/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:contracts": "cd contracts/near && cargo test",
    "start": "node --import tsx src/server/production/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "e2e:testnet": "node --import tsx scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@fast-auth-near/browser-sdk": "1.4.2",
    "@fast-auth-near/javascript-provider": "1.4.1",
    "@hot-labs/near-connect": "0.11.4",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@vitejs/plugin-react": "latest",
    "borsh": "2.0.0",
    "buffer": "6.0.3",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "near-api-js": "7.3.1",
    "near-api-js-v5": "npm:near-api-js@5.1.1",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.15",
    "viem": "^2.57.2",
    "vite": "latest",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "railway": "^3.12.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
