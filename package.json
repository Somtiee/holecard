{
  "name": "agent-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/production/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/production/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:contracts": "forge test --offline",
    "arc:preflight": "node --import tsx scripts/arc-preflight.ts",
    "arc:deploy:v2": "node --import tsx scripts/deploy-arc-v2.ts",
    "start": "node --import tsx src/server/production/index.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.0",
    "@circle-fin/app-kit": "^1.16.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.15",
    "viem": "^2.57.2",
    "vite": "latest",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "railway": "^3.12.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
